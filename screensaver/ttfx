#!/bin/bash
# Violet Oni: synchronized native screensaver, ordinary ttfx calls pass through.
set -euo pipefail
engine=/usr/bin/ttfx
theme_dir="$HOME/.local/state/omarchy/current/theme"
branding_file="$HOME/.config/omarchy/branding/screensaver.txt"
theme_name=""
read -r theme_name <"$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true
original=("$@")
input_file=""
random_effect=false
screensaver_cursor=false
while (( $# )); do
  case "$1" in
    -i|--input-file|--frame-rate)
      (( $# >= 2 )) || exec "$engine" "${original[@]}"
      [[ $1 == --frame-rate ]] || input_file=$2
      shift 2 ;;
    --random-effect|-R) random_effect=true; shift ;;
    --no-restore-cursor) screensaver_cursor=true; shift ;;
    *) shift ;;
  esac
done
if [[ $theme_name == violet-oni && $input_file == "$branding_file" && $random_effect == true && $screensaver_cursor == true && -s "$theme_dir/screensaver/controller.py" && -s "$theme_dir/screensaver/scenes/01-road-of-ashes.txt" ]]; then
  exec /usr/bin/python3 "$theme_dir/screensaver/controller.py" "$theme_dir/screensaver/scenes"
fi
exec "$engine" "${original[@]}"
